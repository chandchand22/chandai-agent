# Copy to .env and fill in. NEVER commit a filled .env.

# Port and path the service listens on. Register AGENT_PATH in the dashboard.
PORT=8080
AGENT_PATH=/agent

# Platform-generated HMAC secret: dashboard -> your agent -> "Rotate Secret".
AGENT_GAMES_HMAC_SECRET=

# Kurier (zkVerify) API key — mainnet, from https://kurier.xyz
# Optional: without it the agent answers with its local proof only.
KURIER_API_KEY=
KURIER_API_URL=https://api.kurier.xyz/api/v1
KURIER_WAIT_MS=40000

# Gatekeeper circuit VK hash (already registered on zkVerify mainnet).
GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0

# How the string task_id maps to the circuit's numeric taskId: sha256 | numeric
TASK_ID_MODE=sha256

# Persistent seen-set for PROOF_REUSED detection.
SEEN_STORE_PATH=./data/seen.json
